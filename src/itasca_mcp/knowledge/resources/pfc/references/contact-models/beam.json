{
  "model": "beam",
  "full_name": "Beam Contact Model",
  "search_keywords": [
    "beam",
    "contact model",
    "pfc"
  ],
  "description": "Structural beam contact model (bm_* keyword family): connects two bodies with an elastic beam of given section/length, carrying force and moment. Available on 6.0/7.0/9.x. A string of balls joined by this model (a P-beam) behaves as a prismatic, bisymmetrical beam of isotropic linear elastic material. The model has no methods.",
  "property_groups": [
    {
      "name": "Beam Group",
      "description": "Parameters and state variables per the user guide; names, types and defaults are those live PFC3D reports for a freshly created contact.",
      "properties": [
        {
          "keyword": "bm_A",
          "symbol": "A",
          "description": "Cross-sectional area (used when bm_bhGiven = 0)",
          "type": "FLT",
          "range": "[0.0, +∞)",
          "default": "0.0",
          "modifiable": true
        },
        {
          "keyword": "bm_E",
          "symbol": "E",
          "description": "Young's modulus",
          "type": "FLT",
          "range": "[0.0, +∞)",
          "default": "0.0",
          "modifiable": true
        },
        {
          "keyword": "bm_Estr",
          "symbol": "E_k",
          "description": "Beam strain energy (state variable)",
          "type": "FLT",
          "range": "[0.0, +∞)",
          "default": "0.0",
          "modifiable": false
        },
        {
          "keyword": "bm_Iy",
          "symbol": "I_y",
          "description": "Moment of inertia about the beam y-axis (used when bm_bhGiven = 0)",
          "type": "FLT",
          "range": "[0.0, +∞)",
          "default": "0.0",
          "modifiable": true
        },
        {
          "keyword": "bm_Iz",
          "symbol": "I_z",
          "description": "Moment of inertia about the beam z-axis (used when bm_bhGiven = 0)",
