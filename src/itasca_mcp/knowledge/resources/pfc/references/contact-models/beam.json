          "range": "[0.0, +∞)",
          "default": "0.0",
          "modifiable": true
        },
        {
          "keyword": "bm_J",
          "symbol": "J",
          "description": "Polar moment of inertia (used when bm_bhGiven = 0)",
          "type": "FLT",
          "range": "[0.0, +∞)",
          "default": "0.0",
          "modifiable": true
        },
        {
          "keyword": "bm_L",
          "symbol": "L",
          "description": "Beam length (state variable)",
          "type": "FLT",
