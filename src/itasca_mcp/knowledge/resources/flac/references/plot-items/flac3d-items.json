        "uniform-mag",
        "value"
      ],
      "notes": [
        "'value' selects the vector quantity: acceleration, displacement, flow, flux, force-applied, reaction, unbalanced-force, velocity."
      ]
    },
    "zone-tensor": {
      "keywords": [
        "active",
        "clip",
        "color-by",
